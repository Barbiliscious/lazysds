# ─── Browser-safe (VITE_ prefix exposes these to the frontend bundle) ───────

# Supabase project URL and anon/publishable key. The anon key is designed to
# be public; row-level security policies limit what it can do.
VITE_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
VITE_SUPABASE_ANON_KEY=sb_publishable_...

# Optional: the SharePoint document library the exported PDFs get uploaded
# to - the direct file path (Documents library -> folder), NOT a "Copy link"
# sharing URL (those carry a random token and can't be generated in advance).
# Joined with each record's SDS Filename + ".pdf" to build the SDS Link
# column in the SharePoint-ready export. Leave unset to export with that
# column blank. Example (Grampians Community Health):
# https://grampianscommunityhealth.sharepoint.com/sites/InformationAssetsTeam/Shared%20Documents/Safety%20Data%20Sheets/
VITE_SHAREPOINT_LIBRARY_URL=https://YOUR_TENANT.sharepoint.com/sites/YOUR_SITE/Shared%20Documents/SDS

# ─── Server-side ONLY — set in Vercel env vars, never VITE_-prefixed ────────

# Anthropic API key, used by /api/extract (SDS field extraction).
ANTHROPIC_API_KEY=sk-ant-...

# RESEND_API_KEY enables two things (api/_lib/email.ts), get a key from
# https://resend.com (free tier):
#  - Optional: emails a one-row spreadsheet copy plus the SDS PDF to
#    REGISTER_NOTIFY_EMAIL every time a record is saved (api/send-copy.ts).
#    Leave REGISTER_NOTIFY_EMAIL unset to turn just this off.
#  - "Email selected records" on the register page (api/send-export.ts):
#    pick records, type any recipient address, send a link to a zip of
#    them. Needs only RESEND_API_KEY - no fixed recipient to configure.
# Both send from notify@lazysds.com, which requires lazysds.com to be a
# verified sending domain in Resend (Resend dashboard -> Domains -> add
# lazysds.com -> add the DNS records it gives you at your registrar -> wait
# for verification). Until it's verified, sends will fail outright - there's
# no more shared-sandbox-sender fallback now that recipients aren't fixed.
RESEND_API_KEY=
REGISTER_NOTIFY_EMAIL=
