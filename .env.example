# ─── Browser-safe (VITE_ prefix exposes these to the frontend bundle) ───────

# Supabase project URL and anon/publishable key. The anon key is designed to
# be public; row-level security policies limit what it can do.
VITE_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
VITE_SUPABASE_ANON_KEY=sb_publishable_...

# ─── Server-side ONLY — set in Vercel env vars, never VITE_-prefixed ────────

# Anthropic API key, used by /api/extract.
ANTHROPIC_API_KEY=sk-ant-...

# That's it. Flow B (finding an SDS) was built without a search API, and
# barcode scanning is deferred until a viable product-lookup API exists —
# if one is adopted later, document its key here first (see CLAUDE.md
# build phases).
