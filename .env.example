# ─── Browser-safe (VITE_ prefix exposes these to the frontend bundle) ───────

# Supabase project URL and anon/publishable key. The anon key is designed to
# be public; row-level security policies limit what it can do.
VITE_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
VITE_SUPABASE_ANON_KEY=sb_publishable_...

# ─── Server-side ONLY — set in Vercel env vars, never VITE_-prefixed ────────

# Anthropic API key, used by /api/extract (SDS field extraction) and by
# /api/barcode's last-resort AI web-search fallback (api/_lib/barcode/web-search.ts).
ANTHROPIC_API_KEY=sk-ant-...

# Same Supabase project as VITE_SUPABASE_URL/VITE_SUPABASE_ANON_KEY above,
# just without the VITE_ prefix - Vite only bundles VITE_-prefixed vars into
# the browser build, so api/ needs its own copies to check the barcode
# mapping table (api/_lib/supabase.ts). Not a secret, same as the VITE_ pair.
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_ANON_KEY=sb_publishable_...

# Optional UPC Database fallback, used only by /api/barcode after the free
# Open*Facts services do not recognise a barcode.
UPC_DATABASE_API_KEY=

# Optional eandata.com (UPC/EAN) fallback, used by /api/barcode after the free
# Open*Facts services (and UPC Database, if set) miss. Free tier is limited to
# a small number of lookups a day. Get a keycode from eandata.com.
EANDATA_API_KEY=

# Flow B (finding an SDS by pasting a link) remains deliberately key-free -
# it uses a guided web search and the SSRF-guarded fetch route.
