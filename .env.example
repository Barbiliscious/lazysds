# ─── Browser-safe (VITE_ prefix exposes these to the frontend bundle) ───────

# Supabase project URL and anon/publishable key. The anon key is designed to
# be public; row-level security policies limit what it can do.
VITE_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
VITE_SUPABASE_ANON_KEY=sb_publishable_...

# ─── Server-side ONLY — set in Vercel env vars, never VITE_-prefixed ────────

# Anthropic API key, used by /api/extract. (Phase 2)
ANTHROPIC_API_KEY=sk-ant-...

# Google Programmable Search, used by /api/find-sds web-search adapter. (Phase 4)
GOOGLE_SEARCH_API_KEY=
GOOGLE_SEARCH_ENGINE_ID=

# Barcode lookup, used by /api/barcode. (Phase 5)
GO_UPC_API_KEY=
